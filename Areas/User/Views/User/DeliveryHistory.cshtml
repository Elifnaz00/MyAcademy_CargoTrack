@using DtoLayer.DTOs.CargoDtos
@model List<UserDeliveryHistoryDto>
@{
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}
<main class="md:ml-64 pt-20 pb-16 px-4 md:px-space-xl max-w-[1600px] mx-auto space-y-6">
<section class="bg-surface-container-lowest rounded-2xl border border-surface-container elevation-1 p-space-lg">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
        <div>
            <h3 class="text-headline-md font-headline-md text-on-surface">Teslimat Geçmişi &amp; Makbuzlar</h3>
            <p class="text-body-sm font-body-sm text-on-surface-variant">Başarıyla sonuçlanan kargolarınız, faturalar ve teslim tutanakları</p>
        </div>
        <button class="flex items-center gap-1.5 px-3.5 py-2 bg-surface hover:bg-surface-container text-on-surface border border-surface-container rounded-xl text-label-md font-label-md transition self-start sm:self-auto">
            <span class="material-symbols-outlined text-[18px]" data-icon="download">download</span>
            <span>Tüm Raporu İndir (.xlsx)</span>
        </button>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface border-b border-surface-container text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider">
                    <th class="py-3 px-4">Teslim Tarihi</th>
                    <th class="py-3 px-4">Takip No</th>
                    <th class="py-3 px-4">Gönderici / İçerik</th>
                    <th class="py-3 px-4">Teslim Alan Kişi</th>
                    <th class="py-3 px-4">Memnuniyet</th>
                    <th class="py-3 px-4 text-right">İşlemler</th>
                </tr>
            </thead>
                <tbody class="divide-y divide-surface-container">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-surface transition-colors">
                                <td class="py-3.5 px-4 font-semibold text-on-surface">
                                    @(item.DeliveryDate?.ToString("dd MMM yyyy, HH:mm") ?? "-")
                                </td>

                                <td class="py-3.5 px-4">
                                    <span class="font-code-tracking text-code-tracking text-on-surface font-mono">
                                        #@item.TrackCode
                                    </span>
                                </td>

                                <td class="py-3.5 px-4">
                                    <div class="text-on-surface font-medium">
                                        @item.SenderName
                                    </div>
                                    <div class="text-label-sm font-label-sm text-on-surface-variant">
                                        Kargo göndericisi
                                    </div>
                                </td>

                                <td class="py-3.5 px-4">
                                    <span class="inline-flex items-center gap-1 text-on-surface font-medium text-body-sm">
                                        <span class="material-symbols-outlined text-[16px]">
                                            verified_user
                                        </span>
                                        @item.RecipientName
                                    </span>
                                </td>

                                <td class="py-3.5 px-4">
                                    <span class="text-label-sm text-on-surface-variant">
                                        Henüz değerlendirme yok
                                    </span>
                                </td>

                                <td class="py-3.5 px-4 text-right">
                                    <span class="text-label-sm text-on-surface-variant">
                                        -
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-8 text-center text-on-surface-variant">
                                Henüz teslim edilmiş kargonuz bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>
        </table>
    </div>
</section>

</main>