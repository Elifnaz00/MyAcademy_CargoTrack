@using DtoLayer.DTOs.DeliveryExceptionDtos
@using EntityLayer.Entities.Enums
@model List<DeliveryExceptionListDto>

@{
    ViewData["Title"] = "Sorunlu Kargolar";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<main class="md:ml-64 pt-20 pb-16 px-4 md:px-space-xl max-w-[1600px] mx-auto space-y-6">

    <div class="mb-5">
        <a href="/Manager/Dashboard/Index"
           class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-indigo-600 transition">
            <i class="fa-solid fa-arrow-left"></i>
            Dashboard'a Dön
        </a>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm mb-6">

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 p-6 border-b border-slate-100">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center">
                    <i class="fa-solid fa-triangle-exclamation text-amber-600"></i>
                </div>
                <div>
                    <h2 class="font-bold text-slate-800">Sorunlu Kargolar</h2>
                    <p class="text-xs text-slate-500 mt-1">
                        Çözüm bekleyen teslimat istisnaları
                    </p>
                </div>
            </div>

            <span class="text-sm font-semibold text-slate-500">
                Toplam: @(Model?.Count ?? 0) sorun
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">

                <thead class="bg-slate-50 text-xs text-slate-500 uppercase">
                    <tr>
                        <th class="px-6 py-4">Takip Kodu</th>
                        <th class="px-6 py-4">Sorun Türü</th>
                        <th class="px-6 py-4">Açıklama</th>
                        <th class="px-6 py-4">Oluşturulma Tarihi</th>
                        <th class="px-6 py-4">İlgili Personel</th>
                        <th class="px-6 py-4">Durum</th>
                        <th class="px-6 py-4 text-right">İşlem</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-amber-50/30 transition">

                                <td class="px-6 py-4 font-bold text-indigo-600">
                                    @item.TrackCode
                                </td>

                                <td class="px-6 py-4 text-slate-700">
                                    @switch (item.DeliveryExceptionType)
                                    {
                                        case ExceptionType.RecipientNotAvailable:
                                            @:Alıcı Adreste Bulunamadı
                                            break;
                                        case ExceptionType.IncorrectAddress:
                                            @:Hatalı Adres
                                            break;
                                        case ExceptionType.DamagedCargo:
                                            @:Hasarlı Kargo
                                            break;
                                        case ExceptionType.RecipientRejected:
                                            @:Alıcı Gönderiyi Reddetti
                                            break;
                                        case ExceptionType.Other:
                                            @:Diğer
                                            break;
                                        default:
                                            @item.DeliveryExceptionType
                                            break;
                                    }
                                </td>

                                <td class="px-6 py-4 text-slate-600 max-w-xs">
                                    <span class="block truncate" title="@item.Description">
                                        @item.Description
                                    </span>
                                </td>

                                <td class="px-6 py-4 text-slate-500 whitespace-nowrap">
                                    @item.ExceptionDate.ToString("dd.MM.yyyy HH:mm")
                                </td>

                                <td class="px-6 py-4 text-slate-600">
                                    @item.EmployeeName
                                </td>

                                <td class="px-6 py-4">
                                    @if (item.IsResolved)
                                    {
                                        <span class="bg-emerald-50 text-emerald-700 px-3 py-1.5 rounded-lg text-xs font-bold">
                                            Çözüldü
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="bg-amber-50 text-amber-700 px-3 py-1.5 rounded-lg text-xs font-bold">
                                            Çözüm Bekliyor
                                        </span>
                                    }
                                </td>

                                <td class="px-6 py-4 text-right">
                                    <a href="/Manager/DeliveryException/Detail/@item.Id"
                                       class="text-indigo-600 font-semibold hover:underline whitespace-nowrap">
                                        İncele
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center">
                                <div class="flex flex-col items-center gap-3 text-slate-400">
                                    <i class="fa-solid fa-circle-check text-3xl text-emerald-500"></i>
                                    <span class="font-semibold text-slate-600">
                                        Çözüm bekleyen sorun bulunmuyor.
                                    </span>
                                    <span class="text-xs">
                                        Şubenize ait bekleyen teslimat istisnası bulunmamaktadır.
                                    </span>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>

</main>