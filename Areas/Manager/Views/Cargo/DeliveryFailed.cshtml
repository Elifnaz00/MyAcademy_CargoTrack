@model MyAcademy_CargoTrack.Areas.Manager.Models.DeliveryFailedViewModel

@{
    ViewData["Title"] = "Teslimat Başarısızlığı";
    Layout = "~/Areas/Manager/Views/Shared/_ManagerLayout.cshtml";
}

<div class="ml-64 pt-16 min-h-screen bg-[#f8f9ff] p-8">

    <div class="max-w-2xl mx-auto bg-white rounded-xl shadow-sm border border-gray-100 p-8">

        <h1 class="text-2xl font-bold text-gray-800 mb-2">
            Teslimat Başarısızlığı
        </h1>

        <p class="text-sm text-gray-500 mb-7">
            Teslimatın neden gerçekleştirilemediğini kaydedin.
        </p>

        <form asp-area="Manager"
              asp-controller="Cargo"
              asp-action="DeliveryFailed"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="CargoId" />

            <div class="mb-6">
                <label asp-for="ExceptionType" class="block text-sm font-medium text-gray-700 mb-2">
                    Başarısızlık Nedeni
                </label>

                <select asp-for="ExceptionType"
                        asp-items="Html.GetEnumSelectList<EntityLayer.Entities.Enums.ExceptionType>()"
                        class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-100">
                    <option value="">Neden seçiniz</option>
                </select>

                <span asp-validation-for="ExceptionType" class="text-red-500 text-xs"></span>
            </div>

            <div class="mb-6">
                <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-2">
                    Açıklama
                </label>

                <textarea asp-for="Description"
                          rows="4"
                          placeholder="Teslimatın neden gerçekleştirilemediğini açıklayın..."
                          class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-100"></textarea>

                <span asp-validation-for="Description" class="text-red-500 text-xs"></span>
            </div>

            <div class="flex justify-end gap-3">
                <a asp-area="Manager"
                   asp-controller="Cargo"
                   asp-action="Incoming"
                   class="px-5 py-2.5 rounded-lg border border-gray-200 text-gray-600 text-sm">
                    Vazgeç
                </a>

                <button type="submit"
                        class="px-5 py-2.5 rounded-lg bg-red-600 text-white text-sm font-medium hover:bg-red-700">
                    Teslimat Başarısızlığını Kaydet
                </button>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}