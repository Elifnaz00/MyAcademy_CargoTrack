@model MyAcademy_CargoTrack.Areas.Manager.Models.CreateCargoViewModel

@{
    ViewData["Title"] = "Yeni Kargo Oluştur";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="ml-64 pt-16 min-h-screen bg-[#f8f9ff]">
    <div class="max-w-6xl mx-auto p-8">

        <!-- Başlık -->
        <div class="mb-8">
            <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
                <span>Kargo Yönetimi</span>
                <span>/</span>
                <span class="text-orange-700 font-medium">Yeni Kargo</span>
            </div>

            <h1 class="text-2xl font-bold text-[#0b1c30]">
                Yeni Kargo Oluştur
            </h1>

            <p class="text-sm text-gray-500 mt-2">
                Gönderi bilgilerini doldurarak yeni bir kargo kaydı oluşturabilirsiniz.
            </p>
        </div>

        <form asp-area="Manager"
              asp-controller="Cargo"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-red-600 text-sm mb-4">
            </div>

            <!-- Müşteri Bilgileri -->
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 mb-6">

                <h2 class="text-lg font-semibold text-[#0b1c30] mb-6">
                    Müşteri Bilgileri
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                    <div>
                        <label asp-for="SenderCustomerId"
                               class="block text-sm font-medium text-gray-700 mb-2">
                            Gönderici
                        </label>

                        <select asp-for="SenderCustomerId"
                                asp-items="Model.Customers"
                                class="w-full rounded-lg border-gray-300 focus:border-orange-500 focus:ring-orange-500">
                            <option value="">Gönderici seçiniz</option>
                        </select>

                        <span asp-validation-for="SenderCustomerId"
                              class="text-red-500 text-xs">
                        </span>
                    </div>

                    <div>
                        <label asp-for="ReceiverCustomerId"
                               class="block text-sm font-medium text-gray-700 mb-2">
                            Alıcı
                        </label>

                        <select asp-for="ReceiverCustomerId"
                                asp-items="Model.Customers"
                                class="w-full rounded-lg border-gray-300 focus:border-orange-500 focus:ring-orange-500">
                            <option value="">Alıcı seçiniz</option>
                        </select>

                        <span asp-validation-for="ReceiverCustomerId"
                              class="text-red-500 text-xs">
                        </span>
                    </div>

                </div>
            </div>

            <!-- Şube Bilgileri -->
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 mb-6">

                <h2 class="text-lg font-semibold text-[#0b1c30] mb-6">
                    Şube Bilgileri
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                    <div>
                        <label asp-for="OriginBranchId"
                               class="block text-sm font-medium text-gray-700 mb-2">
                            Çıkış Şubesi
                        </label>

                        <select asp-for="OriginBranchId"
                                asp-items="Model.Branches"
                                class="w-full rounded-lg border-gray-300 focus:border-orange-500 focus:ring-orange-500">
                            <option value="">Çıkış şubesi seçiniz</option>
                        </select>

                        <span asp-validation-for="OriginBranchId"
                              class="text-red-500 text-xs">
                        </span>
                    </div>

                    <div>
                        <label asp-for="DestinationBranchId"
                               class="block text-sm font-medium text-gray-700 mb-2">
                            Varış Şubesi
                        </label>

                        <select asp-for="DestinationBranchId"
                                asp-items="Model.Branches"
                                class="w-full rounded-lg border-gray-300 focus:border-orange-500 focus:ring-orange-500">
                            <option value="">Varış şubesi seçiniz</option>
                        </select>

                        <span asp-validation-for="DestinationBranchId"
                              class="text-red-500 text-xs">
                        </span>
                    </div>

                </div>
            </div>

            <!-- Paket Bilgileri -->
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 mb-6">

                <h2 class="text-lg font-semibold text-[#0b1c30] mb-6">
                    Paket Bilgileri
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                    <div>
                        <label asp-for="Weight"
                               class="block text-sm font-medium text-gray-700 mb-2">
                            Ağırlık (kg)
                        </label>

                        <input asp-for="Weight"
                               type="number"
                               min="0.01"
                               step="0.01"
                               class="w-full rounded-lg border-gray-300 focus:border-orange-500 focus:ring-orange-500"
                               placeholder="Örn. 2.5" />

                        <span asp-validation-for="Weight"
                              class="text-red-500 text-xs">
                        </span>
                    </div>

                    <div>
                        <label asp-for="Length"
                               class="block text-sm font-medium text-gray-700 mb-2">
                            Uzunluk (cm)
                        </label>

                        <input asp-for="Length"
                               type="number"
                               min="0.01"
                               step="0.01"
                               class="w-full rounded-lg border-gray-300 focus:border-orange-500 focus:ring-orange-500" />

                        <span asp-validation-for="Length"
                              class="text-red-500 text-xs">
                        </span>
                    </div>

                    <div>
                        <label asp-for="Width"
                               class="block text-sm font-medium text-gray-700 mb-2">
                            Genişlik (cm)
                        </label>

                        <input asp-for="Width"
                               type="number"
                               min="0.01"
                               step="0.01"
                               class="w-full rounded-lg border-gray-300 focus:border-orange-500 focus:ring-orange-500" />

                        <span asp-validation-for="Width"
                              class="text-red-500 text-xs">
                        </span>
                    </div>

                    <div>
                        <label asp-for="Height"
                               class="block text-sm font-medium text-gray-700 mb-2">
                            Yükseklik (cm)
                        </label>

                        <input asp-for="Height"
                               type="number"
                               min="0.01"
                               step="0.01"
                               class="w-full rounded-lg border-gray-300 focus:border-orange-500 focus:ring-orange-500" />

                        <span asp-validation-for="Height"
                              class="text-red-500 text-xs">
                        </span>
                    </div>

                    <div>
                        <label asp-for="CargoType"
                               class="block text-sm font-medium text-gray-700 mb-2">
                            Kargo Türü
                        </label>

                        <select asp-for="CargoType"
                                asp-items="Html.GetEnumSelectList<EntityLayer.Entities.Enums.CargoType>()"
                                class="w-full rounded-lg border-gray-300 focus:border-orange-500 focus:ring-orange-500">
                            <option value="">Kargo türü seçiniz</option>
                        </select>

                        <span asp-validation-for="CargoType"
                              class="text-red-500 text-xs">
                        </span>
                    </div>

                    <div>
                        <label asp-for="DeliveryType"
                               class="block text-sm font-medium text-gray-700 mb-2">
                            Teslimat Türü
                        </label>

                        <select asp-for="DeliveryType"
                                asp-items="Html.GetEnumSelectList<EntityLayer.Entities.Enums.DeliveryType>()"
                                class="w-full rounded-lg border-gray-300 focus:border-orange-500 focus:ring-orange-500">
                            <option value="">Teslimat türü seçiniz</option>
                        </select>

                        <span asp-validation-for="DeliveryType"
                              class="text-red-500 text-xs">
                        </span>
                    </div>

                    <div>
                        <label asp-for="DeclaredValue"
                               class="block text-sm font-medium text-gray-700 mb-2">
                            Beyan Edilen Değer (₺)
                        </label>

                        <input asp-for="DeclaredValue"
                               type="number"
                               min="0"
                               step="0.01"
                               class="w-full rounded-lg border-gray-300 focus:border-orange-500 focus:ring-orange-500"
                               placeholder="İsteğe bağlı" />

                        <span asp-validation-for="DeclaredValue"
                              class="text-red-500 text-xs">
                        </span>
                    </div>

                </div>
            </div>

            <!-- Butonlar -->
            <div class="flex justify-end gap-3">

                <a asp-area="Manager"
                   asp-controller="Cargo"
                   asp-action="Index"
                   class="px-5 py-2.5 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 transition">
                    İptal
                </a>

                <button type="submit"
                        class="px-6 py-2.5 rounded-lg bg-[#a73a00] text-white font-medium hover:bg-[#7f2b00] transition shadow-sm">
                    Kargo Oluştur
                </button>

            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
