@model List<DtoLayer.DTOs.CargoDtos.CargoListDto>

@{
    ViewData["Title"] = "Kargo Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main class="ml-64 pt-20 px-8 pb-12">

    <div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-on-surface">Kargo Yönetimi</h1>
            <p class="text-sm text-on-surface-variant mt-1">
                Sistemdeki kargoları görüntüleyebilir ve takip koduyla arama yapabilirsiniz.
            </p>
        </div>
    </div>

    <!-- Search -->
    <section class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 p-5 mb-6">
        <form asp-area="Admin" asp-controller="Cargo" asp-action="Index"
              method="get"
              class="flex flex-col sm:flex-row gap-3">

            <div class="flex-1">
                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       placeholder="Takip koduna göre ara..."
                       class="w-full px-4 py-3 rounded-lg border border-outline-variant/50 bg-surface text-on-surface focus:outline-none focus:ring-2 focus:ring-primary" />
            </div>

            <div class="flex gap-2">
                <button type="submit"
                        class="px-5 py-3 rounded-lg bg-primary text-on-primary font-medium hover:opacity-90 transition">
                    <i class="fa-solid fa-magnifying-glass mr-2"></i>
                    Ara
                </button>

                <a asp-area="Admin"
                   asp-controller="Cargo"
                   asp-action="Index"
                   class="px-5 py-3 rounded-lg border border-outline-variant/50 text-on-surface hover:bg-surface-container transition">
                    Temizle
                </a>
            </div>
        </form>
    </section>

    <!-- Cargo List -->
    <section class="bg-surface-container-lowest rounded-xl border border-outline-variant/30 overflow-hidden">

        <div class="p-5 border-b border-outline-variant/30 flex items-center justify-between">
            <div>
                <h2 class="font-semibold text-on-surface">Kargo Listesi</h2>
                <p class="text-sm text-on-surface-variant mt-1">
                    Toplam @Model.Count kargo listeleniyor.
                </p>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="bg-surface-container-low text-on-surface-variant">
                    <tr>
                        <th class="px-5 py-4 font-semibold">Takip Kodu</th>
                        <th class="px-5 py-4 font-semibold">Çıkış Şehri</th>
                        <th class="px-5 py-4 font-semibold">Varış Şehri</th>
                        <th class="px-5 py-4 font-semibold">Kargo Durumu</th>
                        <th class="px-5 py-4 font-semibold">Tahmini Teslimat</th>
                        <th class="px-5 py-4 font-semibold">Son Hareket</th>
                        <th class="px-5 py-4 font-semibold text-right">İşlem</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-outline-variant/20">

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var cargo in Model)
                        {
                            <tr class="hover:bg-surface-container-low/60 transition">
                                <td class="px-5 py-4 font-semibold text-primary">
                                    @cargo.TrackCode
                                </td>

                                <td class="px-5 py-4 text-on-surface">
                                    @cargo.OriginCity
                                </td>

                                <td class="px-5 py-4 text-on-surface">
                                    @cargo.DestinationCity
                                </td>

                                <td class="px-5 py-4">
                                    <span class="px-3 py-1 rounded-full text-xs font-medium bg-surface-container text-on-surface">
                                        @cargo.CargoStatus
                                    </span>
                                </td>

                                <td class="px-5 py-4 text-on-surface">
                                    @cargo.EstimatedArrivalDate.ToString("dd.MM.yyyy")
                                </td>

                                <td class="px-5 py-4 text-on-surface-variant">
                                    @(cargo.LastMovementDate?.ToString("dd.MM.yyyy HH:mm") ?? "Hareket yok")
                                </td>

                                <td class="px-5 py-4 text-right">
                                    <a asp-area="Admin"
                                       asp-controller="Cargo"
                                       asp-action="Details"
                                       asp-route-id="@cargo.Id"
                                       class="inline-flex items-center gap-2 text-primary hover:underline font-medium">
                                        <i class="fa-regular fa-eye"></i>
                                        Detay
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="px-5 py-12 text-center">
                                <div class="flex flex-col items-center gap-2 text-on-surface-variant">
                                    <i class="fa-solid fa-box-open text-3xl"></i>
                                    <p class="font-medium">Kargo bulunamadı.</p>
                                    <p class="text-xs">Arama kriterlerinizi kontrol edebilirsiniz.</p>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </section>

</main>
