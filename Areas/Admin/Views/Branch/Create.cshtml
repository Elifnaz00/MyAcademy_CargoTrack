@using Microsoft.AspNetCore.Mvc.Rendering
@model DtoLayer.DTOs.BranchDtos.CreateBranchDto

@{
    ViewData["Title"] = "Yeni Şube Ekle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main class="ml-64 pt-20 px-8 pb-12">

    <!-- Page Header -->
    <div class="mb-6">
        <a asp-area="Admin"
           asp-controller="Branch"
           asp-action="Index"
           class="inline-flex items-center gap-2 text-sm text-on-surface-variant hover:text-primary transition mb-3">
            <i class="fa-solid fa-arrow-left"></i>
            Şube Listesine Dön
        </a>

        <h1 class="text-headline-lg font-headline-lg text-on-surface">
            Yeni Şube Ekle
        </h1>

        <p class="text-body-sm text-on-surface-variant mt-1">
            CargoTrack sistemine yeni bir şube kaydedin.
        </p>
    </div>

    <!-- Create Form -->
    <section class="max-w-3xl p-6 rounded-xl bg-surface-container-lowest border border-outline-variant/30 shadow-sm">

        <div class="mb-6">
            <h2 class="text-headline-md font-headline-md text-on-surface">
                Şube Bilgileri
            </h2>
            <p class="text-body-sm text-on-surface-variant mt-1">
                Yeni şubenin temel bilgilerini giriniz.
            </p>
        </div>

        <form asp-area="Admin"
              asp-controller="Branch"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="mb-4 text-sm text-red-600"></div>

            <!-- Branch Name -->
            <div class="mb-5">
                <label asp-for="Name"
                       class="block text-sm font-semibold text-on-surface mb-2">
                    Şube Adı
                </label>

                <input asp-for="Name"
                       type="text"
                       placeholder="Örn: Kadıköy Şubesi"
                       class="w-full px-4 py-3 rounded-lg border border-outline-variant bg-surface text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/30" />

                <span asp-validation-for="Name"
                      class="text-xs text-red-600 mt-1"></span>
            </div>

            <!-- City -->
            <div class="mb-5">
                <label asp-for="CityId"
                       class="block text-sm font-semibold text-on-surface mb-2">
                    Şehir
                </label>

                <select asp-for="CityId"
                        asp-items="@(new SelectList(ViewBag.Cities, "Id", "Name"))"
                        class="w-full px-4 py-3 rounded-lg border border-outline-variant bg-surface text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/30">
                    <option value="">Şehir seçiniz</option>
                </select>

                <span asp-validation-for="CityId"
                      class="text-xs text-red-600 mt-1"></span>
            </div>

            <!-- Status -->
            <div class="mb-6">
                <label class="flex items-center gap-3 cursor-pointer">
                    <input asp-for="IsActive"
                           type="checkbox"
                           class="w-4 h-4 accent-primary" />

                    <span class="text-sm font-medium text-on-surface">
                        Şube aktif olarak oluşturulsun
                    </span>
                </label>
            </div>

            <!-- Buttons -->
            <div class="flex items-center justify-end gap-3 pt-5 border-t border-outline-variant/30">

                <a asp-area="Admin"
                   asp-controller="Branch"
                   asp-action="Index"
                   class="px-5 py-2.5 rounded-lg border border-outline-variant text-on-surface-variant font-semibold hover:bg-surface-container-low transition">
                    Vazgeç
                </a>

                <button type="submit"
                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-primary text-on-primary font-semibold hover:opacity-90 transition">
                    <i class="fa-solid fa-plus"></i>
                    Şubeyi Kaydet
                </button>

            </div>

        </form>

    </section>

</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
