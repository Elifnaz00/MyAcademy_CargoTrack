
@model List<DtoLayer.DTOs.BranchDtos.ResultBranchDto>

@{
    ViewData["Title"] = "Şube Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main class="ml-64 pt-20 px-8 pb-12">

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="text-headline-lg font-headline-lg text-on-surface">
                Şube Yönetimi
            </h1>
            <p class="text-body-sm font-body-sm text-on-surface-variant mt-1">
                Kargo operasyonlarında kullanılan şubeleri görüntüleyebilir ve yönetebilirsiniz.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Branch"
           asp-action="Create"
           class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-primary text-on-primary font-semibold hover:opacity-90 transition">
            <i class="fa-solid fa-plus"></i>
            Yeni Şube Ekle
        </a>
    </div>

    <!-- Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="mb-5 p-4 rounded-xl bg-green-50 border border-green-200 text-green-700 text-sm">
            <i class="fa-solid fa-circle-check mr-2"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="mb-5 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm">
            <i class="fa-solid fa-circle-exclamation mr-2"></i>
            @TempData["Error"]
        </div>
    }

    <!-- Branch Table -->
    <section class="p-6 rounded-xl bg-surface-container-lowest border border-outline-variant/30 shadow-sm">

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
            <div>
                <h2 class="text-headline-md font-headline-md text-on-surface">
                    Şubeler
                </h2>
                <p class="text-body-sm font-body-sm text-on-surface-variant">
                    Sistemde kayıtlı tüm şubelerin listesi
                </p>
            </div>

            <div class="text-body-sm text-on-surface-variant">
                Toplam
                <span class="font-bold text-on-surface">@Model.Count</span>
                şube
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">

                <thead>
                    <tr class="bg-surface-container-low text-on-surface-variant text-label-sm font-label-sm uppercase tracking-wider h-11 border-b border-outline-variant/30">
                        <th class="py-3 px-4 w-12 text-center">#</th>
                        <th class="py-3 px-4">Şube Adı</th>
                        <th class="py-3 px-4">Şehir</th>
                        <th class="py-3 px-4">Durum</th>
                        <th class="py-3 px-4 text-right">İşlemler</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-outline-variant/20 text-body-sm font-body-sm">

                    @if (Model != null && Model.Any())
                    {
                        for (int i = 0; i < Model.Count; i++)
                        {
                            var branch = Model[i];

                            <tr class="hover:bg-surface-container-low/50 transition-colors">

                                <td class="py-3.5 px-4 text-center font-semibold text-on-surface">
                                    @(i + 1)
                                </td>

                                <td class="py-3.5 px-4">
                                    <div class="font-semibold text-on-surface">
                                        @branch.Name
                                    </div>
                                </td>

                                <td class="py-3.5 px-4 text-on-surface-variant">
                                    @branch.CityName
                                </td>

                                <td class="py-3.5 px-4">
                                    @if (branch.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-green-100 text-green-700 text-xs font-semibold">
                                            <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gray-100 text-gray-600 text-xs font-semibold">
                                            <span class="w-1.5 h-1.5 rounded-full bg-gray-500"></span>
                                            Pasif
                                        </span>
                                    }
                                </td>

                                <td class="py-3.5 px-4">
                                    <div class="flex items-center justify-end gap-2">

                                        <a asp-area="Admin"
                                           asp-controller="Branch"
                                           asp-action="Edit"
                                           asp-route-id="@branch.Id"
                                           class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 transition"
                                           title="Düzenle">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>

                                        <form asp-area="Admin"
                                              asp-controller="Branch"
                                              asp-action="ChangeStatus"
                                              method="post"
                                              class="inline">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@branch.Id" />
                                            <input type="hidden" name="isActive" value="@(!branch.IsActive)" />

                                            <button type="submit"
                                                    class="inline-flex items-center justify-center w-9 h-9 rounded-lg @(branch.IsActive ? "bg-orange-50 text-orange-600 hover:bg-orange-100" : "bg-green-50 text-green-600 hover:bg-green-100") transition"
                                                    title="@(branch.IsActive ? "Pasife Al" : "Aktif Et")">
                                                <i class="fa-solid @(branch.IsActive ? "fa-ban" : "fa-check")"></i>
                                            </button>
                                        </form>

                                        <form asp-area="Admin"
                                              asp-controller="Branch"
                                              asp-action="Delete"
                                              method="post"
                                              class="inline"
                                              onsubmit="return confirm('Bu şubeyi silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@branch.Id" />

                                            <button type="submit"
                                                    class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 transition"
                                                    title="Sil">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="py-10 px-4 text-center text-on-surface-variant">
                                <div class="flex flex-col items-center gap-3">
                                    <i class="fa-solid fa-building text-3xl opacity-40"></i>
                                    <span>Henüz kayıtlı şube bulunmuyor.</span>
                                    <a asp-area="Admin"
                                       asp-controller="Branch"
                                       asp-action="Create"
                                       class="text-primary font-semibold hover:underline">
                                        İlk şubeyi oluştur
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>

    </section>

</main>


