@model List<DtoLayer.DTOs.EmployeeDtos.ResultEmployeeDto>

@{
    ViewData["Title"] = "Personel Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main class="ml-64 pt-20 px-8 pb-12">

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-2xl font-bold text-on-surface">
                Personel Yönetimi
            </h1>
            <p class="text-sm text-on-surface-variant mt-1">
                Şirket personellerini görüntüleyebilir ve yönetebilirsiniz.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Employee"
           asp-action="Create"
           class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-primary text-white font-medium hover:opacity-90 transition">
            <span class="text-lg">+</span>
            Yeni Personel Ekle
        </a>
    </div>

    <!-- Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-green-100 text-green-800 border border-green-200">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-red-100 text-red-800 border border-red-200">
            @TempData["Error"]
        </div>
    }

    <!-- Employee Table -->
    <section class="rounded-2xl bg-surface-container-lowest border border-outline-variant/30 shadow-sm overflow-hidden">

        <div class="flex items-center justify-between p-6 border-b border-outline-variant/30">
            <div>
                <h2 class="text-lg font-semibold text-on-surface">
                    Personel Listesi
                </h2>
                <p class="text-sm text-on-surface-variant mt-1">
                    Sistemde kayıtlı personeller
                </p>
            </div>

            <span class="px-3 py-1.5 rounded-lg bg-surface-container text-sm font-medium text-on-surface">
                Toplam: @Model.Count
            </span>
        </div>

        @if (Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="bg-surface-container-low text-on-surface-variant">
                        <tr>
                            <th class="px-6 py-4 font-semibold">Personel</th>
                            <th class="px-6 py-4 font-semibold">Personel No</th>
                            <th class="px-6 py-4 font-semibold">Pozisyon</th>
                            <th class="px-6 py-4 font-semibold">Şube</th>
                            <th class="px-6 py-4 font-semibold">Şehir</th>
                            <th class="px-6 py-4 font-semibold">Durum</th>
                            <th class="px-6 py-4 font-semibold text-center">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-outline-variant/30">
                        @foreach (var employee in Model)
                        {
                            <tr class="hover:bg-surface-container-low/50 transition">

                                <td class="px-6 py-4">
                                    <div class="font-semibold text-on-surface">
                                        @employee.FullName
                                    </div>
                                    <div class="text-xs text-on-surface-variant mt-1">
                                        @employee.Email
                                    </div>
                                </td>

                                <td class="px-6 py-4 text-on-surface">
                                    @employee.EmployeeNumber
                                </td>

                                <td class="px-6 py-4 text-on-surface">
                                    @employee.Position
                                </td>

                                <td class="px-6 py-4 text-on-surface">
                                    @employee.BranchName
                                </td>

                                <td class="px-6 py-4 text-on-surface">
                                    @employee.CityName
                                </td>

                                <td class="px-6 py-4">
                                    @if (employee.IsActive)
                                    {
                                        <span class="inline-flex px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700">
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-700">
                                            Pasif
                                        </span>
                                    }
                                </td>

                                <td class="px-6 py-4">
                                    <div class="flex items-center justify-center gap-3">

                                        <a asp-area="Admin"
                                           asp-controller="Employee"
                                           asp-action="Edit"
                                           asp-route-id="@employee.AppUserId"
                                           class="px-3 py-2 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 transition font-medium">
                                            Düzenle
                                        </a>

                                        <form asp-area="Admin"
                                              asp-controller="Employee"
                                              asp-action="ChangeStatus"
                                              method="post"
                                              onsubmit="return confirm('Personel durumunu değiştirmek istediğinize emin misiniz?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@employee.AppUserId" />

                                            <input type="hidden"
                                                   name="isActive"
                                                   value="@(!employee.IsActive)" />

                                            @if (employee.IsActive)
                                            {
                                                <button type="submit"
                                                        class="px-3 py-2 rounded-lg bg-red-50 text-red-700 hover:bg-red-100 transition font-medium">
                                                    Pasife Al
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="px-3 py-2 rounded-lg bg-green-50 text-green-700 hover:bg-green-100 transition font-medium">
                                                    Aktifleştir
                                                </button>
                                            }
                                        </form>

                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="py-16 px-6 text-center">
                <div class="text-4xl mb-4">👥</div>

                <h3 class="text-lg font-semibold text-on-surface mb-2">
                    Henüz personel kaydı bulunmuyor
                </h3>

                <p class="text-sm text-on-surface-variant mb-6">
                    Sisteme henüz personel eklenmemiş.
                </p>

                <a asp-area="Admin"
                   asp-controller="Employee"
                   asp-action="Create"
                   class="inline-flex items-center px-5 py-3 rounded-xl bg-primary text-white font-medium hover:opacity-90 transition">
                    İlk Personeli Ekle
                </a>
            </div>
        }

    </section>
</main>
