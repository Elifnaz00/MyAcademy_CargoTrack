@model DtoLayer.DTOs.CargoPriceDtos.CreateCargoPriceDto

@{
    ViewData["Title"] = "Yeni Fiyat Tarifesi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<main class="ml-64 pt-20 px-8 pb-12">
    <div class="mb-8">
        <a asp-action="Index" class="text-sm text-primary hover:underline">
            ← Fiyat Yönetimine Dön
        </a>
        <h1 class="text-2xl font-bold text-on-surface mt-4">Yeni Fiyat Tarifesi</h1>
        <p class="text-sm text-on-surface-variant mt-1">
            Kargo ücret hesaplamasında kullanılacak fiyat bilgilerini girin.
        </p>
    </div>

    <section class="max-w-3xl bg-surface-container-lowest rounded-2xl border border-outline-variant/30 shadow-sm p-8">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm mb-5"></div>

            <h2 class="font-semibold text-on-surface mb-5">Temel Ücretler</h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label asp-for="PricePerKg" class="block text-sm font-medium mb-2">
                        Kilogram Başına Ücret (₺)
                    </label>
                    <input asp-for="PricePerKg" type="number" step="0.01"
                           class="w-full rounded-xl border border-outline-variant p-3 bg-surface" />
                    <span asp-validation-for="PricePerKg" class="text-red-600 text-xs"></span>
                </div>

                <div>
                    <label asp-for="PricePerDesi" class="block text-sm font-medium mb-2">
                        Desi Başına Ücret (₺)
                    </label>
                    <input asp-for="PricePerDesi" type="number" step="0.01"
                           class="w-full rounded-xl border border-outline-variant p-3 bg-surface" />
                    <span asp-validation-for="PricePerDesi" class="text-red-600 text-xs"></span>
                </div>

                <div>
                    <label asp-for="ExtraServicePrice" class="block text-sm font-medium mb-2">
                        Ek Hizmet Ücreti (₺)
                    </label>
                    <input asp-for="ExtraServicePrice" type="number" step="0.01"
                           class="w-full rounded-xl border border-outline-variant p-3 bg-surface" />
                    <span asp-validation-for="ExtraServicePrice" class="text-red-600 text-xs"></span>
                </div>
            </div>

            <div class="border-t border-outline-variant/30 my-8"></div>

            <h2 class="font-semibold text-on-surface mb-2">Fiyat Katsayıları</h2>
            <p class="text-sm text-on-surface-variant mb-5">
                Kargo ücretinin hesaplanmasında uygulanacak çarpan değerleri.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label asp-for="RegionCoefficient" class="block text-sm font-medium mb-2">
                        Bölge Katsayısı
                    </label>
                    <input asp-for="RegionCoefficient" type="number" step="0.01"
                           class="w-full rounded-xl border border-outline-variant p-3 bg-surface" />
                    <span asp-validation-for="RegionCoefficient" class="text-red-600 text-xs"></span>
                </div>

                <div>
                    <label asp-for="DeliveryTypeCoefficient" class="block text-sm font-medium mb-2">
                        Teslimat Türü Katsayısı
                    </label>
                    <input asp-for="DeliveryTypeCoefficient" type="number" step="0.01"
                           class="w-full rounded-xl border border-outline-variant p-3 bg-surface" />
                    <span asp-validation-for="DeliveryTypeCoefficient" class="text-red-600 text-xs"></span>
                </div>
            </div>

            <div class="flex justify-end gap-3 mt-8">
                <a asp-action="Index"
                   class="px-5 py-3 rounded-xl border border-outline-variant text-on-surface font-medium">
                    Vazgeç
                </a>
                <button type="submit"
                        class="px-5 py-3 rounded-xl bg-primary text-white font-medium hover:opacity-90">
                    Tarifeyi Kaydet
                </button>
            </div>
        </form>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
