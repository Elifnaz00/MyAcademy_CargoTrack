@model LoginViewModel

<!DOCTYPE html>

<html class="h-full bg-surface" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>KargoHQ - Kurumsal Giriş Yap</title>
    <!-- Material Symbols Outlined -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Plus+Jakarta+Sans:wght@500;600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <!-- Tailwind CSS v3 -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                "primary": "#000000",
                "outline": "#76777d",
                "on-primary": "#ffffff",
                "inverse-primary": "#bec6e0",
                "on-primary-container": "#7c839b",
                "on-error-container": "#93000a",
                "tertiary": "#000000",
                "inverse-on-surface": "#eaf1ff",
                "surface-dim": "#cbdbf5",
                "surface-container": "#e5eeff",
                "background": "#f8f9ff",
                "surface-container-lowest": "#ffffff",
                "on-error": "#ffffff",
                "tertiary-container": "#002113",
                "outline-variant": "#c6c6cd",
                "on-surface-variant": "#45464d",
                "on-tertiary": "#ffffff",
                "primary-fixed-dim": "#bec6e0",
                "surface-container-high": "#dce9ff",
                "secondary": "#a73a00",
                "secondary-fixed": "#ffdbce",
                "on-secondary-container": "#571a00",
                "tertiary-fixed": "#6ffbbe",
                "surface-tint": "#565e74",
                "on-tertiary-fixed-variant": "#005236",
                "on-tertiary-fixed": "#002113",
                "on-secondary": "#ffffff",
                "on-secondary-fixed-variant": "#7f2b00",
                "surface-container-highest": "#d3e4fe",
                "on-primary-fixed": "#131b2e",
                "primary-fixed": "#dae2fd",
                "tertiary-fixed-dim": "#4edea3",
                "secondary-fixed-dim": "#ffb599",
                "on-background": "#0b1c30",
                "primary-container": "#131b2e",
                "surface-bright": "#f8f9ff",
                "on-primary-fixed-variant": "#3f465c",
                "surface-variant": "#d3e4fe",
                "surface-container-low": "#eff4ff",
                "secondary-container": "#fd651e",
                "surface": "#f8f9ff",
                "inverse-surface": "#213145",
                "on-surface": "#0b1c30",
                "on-tertiary-container": "#009668",
                "on-secondary-fixed": "#370e00",
                "error": "#ba1a1a",
                "error-container": "#ffdad6"
              },
              "borderRadius": {
                "DEFAULT": "0.25rem",
                "lg": "0.5rem",
                "xl": "0.75rem",
                "full": "9999px"
              },
              "spacing": {
                "space-xl": "2rem",
                "margin-mobile": "1rem",
                "space-sm": "0.5rem",
                "space-lg": "1.5rem",
                "gutter-sm": "1rem",
                "space-md": "1rem",
                "margin": "2rem",
                "space-2xl": "3rem",
                "gutter": "1.5rem",
                "space-xs": "0.25rem"
              },
              "fontFamily": {
                "headline-md": ["Plus Jakarta Sans"],
                "code-tracking": ["Inter"],
                "label-lg": ["Inter"],
                "headline-lg-mobile": ["Plus Jakarta Sans"],
                "display-mobile": ["Plus Jakarta Sans"],
                "headline-lg": ["Plus Jakarta Sans"],
                "body-md": ["Inter"],
                "display": ["Plus Jakarta Sans"],
                "metric-number": ["Plus Jakarta Sans"],
                "body-sm": ["Inter"],
                "body-lg": ["Inter"],
                "headline-sm": ["Plus Jakarta Sans"],
                "label-md": ["Inter"],
                "label-sm": ["Inter"]
              },
              "fontSize": {
                "headline-md": ["20px", { "lineHeight": "28px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                "code-tracking": ["13px", { "lineHeight": "18px", "letterSpacing": "0.04em", "fontWeight": "600" }],
                "label-lg": ["14px", { "lineHeight": "20px", "fontWeight": "500" }],
                "headline-lg-mobile": ["22px", { "lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                "display-mobile": ["28px", { "lineHeight": "36px", "letterSpacing": "-0.01em", "fontWeight": "700" }],
                "headline-lg": ["28px", { "lineHeight": "36px", "letterSpacing": "-0.015em", "fontWeight": "600" }],
                "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                "display": ["36px", { "lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                "metric-number": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                "body-sm": ["12px", { "lineHeight": "16px", "fontWeight": "400" }],
                "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                "headline-sm": ["16px", { "lineHeight": "24px", "fontWeight": "600" }],
                "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.01em", "fontWeight": "600" }],
                "label-sm": ["11px", { "lineHeight": "14px", "letterSpacing": "0.02em", "fontWeight": "600" }]
              }
            },
          },
        }
    </script>
    <style>
        .material-symbols-outlined {
          font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
          display: inline-block;
          vertical-align: middle;
          line-height: 1;
        }
        .custom-scroll::-webkit-scrollbar {
          width: 5px;
        }
        .custom-scroll::-webkit-scrollbar-thumb {
          background-color: #cbd5e1;
          border-radius: 4px;
        }
    </style>
</head>
<body class="h-full bg-surface text-on-surface antialiased overflow-x-hidden">
    <!-- Minimal Top Header for Focused Brand Context -->
    <header class="w-full bg-surface-container-lowest border-b border-outline-variant z-40 fixed top-0 left-0">
        <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin h-16 flex items-center justify-between">
            <div class="flex items-center gap-space-sm">
                <div class="w-9 h-9 rounded-lg bg-primary-container flex items-center justify-center text-on-primary shadow-sm">
                    <span class="material-symbols-outlined text-secondary-container" data-icon="local_shipping">local_shipping</span>
                </div>
                <span class="font-headline-md text-headline-md font-bold tracking-tight text-on-surface">CargoTrack</span>
                <span class="hidden sm:inline-block ml-space-xs px-2 py-0.5 rounded-full text-label-sm font-label-sm bg-surface-container text-on-surface-variant border border-outline-variant">
                   
                </span>
            </div>
            <div class="flex items-center gap-space-md">
                <a class="flex items-center gap-1.5 text-label-md font-label-md text-on-surface-variant hover:text-secondary transition-colors duration-150" href="#yardim">
                    <span class="material-symbols-outlined text-[18px]" data-icon="help_outline">help_outline</span>
                    <span class="hidden sm:inline">Yardım Merkezi</span>
                </a>
                <div class="h-4 w-px bg-outline-variant"></div>
                <div class="flex items-center gap-1 text-label-sm font-label-sm text-on-surface-variant">
                    <span class="material-symbols-outlined text-[16px]" data-icon="language">language</span>
                    <span class="font-medium">TR / EN</span>
                </div>
            </div>
        </div>
    </header>
    <!-- Main Content Layout (Desktop Split Screen) -->
    <main class="min-h-screen pt-16 flex flex-col lg:flex-row">
        <!-- LEFT SIDE: Showcase & Statistics & Brand Heritage (Hidden on mobile/tablet or responsive stacked) -->
        <div class="lg:w-7/12 relative hidden lg:flex flex-col justify-between p-space-xl xl:p-space-2xl bg-primary-container text-on-primary overflow-hidden">
            <!-- Background Ambient Texture & Image Container -->
            <div class="absolute inset-0 opacity-20 mix-blend-luminosity pointer-events-none">
                <div class="w-full h-full bg-cover bg-center" data-alt="A cutting-edge automated logistics fulfillment center illuminated by pristine industrial cool white lighting with clean orange laser tracking paths. Massive modern robotic sorting conveyors, pallet racks, and streamlined freight vehicles operate in hyper-synchronized efficiency under architectural structural beams. The atmosphere evokes top-tier engineering reliability, zero-error precision, deep navy blues, and energetic logistics orange accents in a state-of-the-art corporate light tone." style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCAM8wapIoC7uiH_m8nZy2mqf21ZflshR1kMU5ROSkVIPj0Aqr0C5Qua9annc4XO3cbJ3PWV5Uzv9hVaFxsVwo200Kh5wXG78xJ7IEchb7BrdqLd_1uMj4YtR6i6-y7XvI92GCu7rcdDlc5ELOpJEZRHTyth8fQKmtNXxz5tzobDNL1lWRl4hIyavWvJhCkyHdHje7_JVQb6YwZ7SBgDsZ0lcXV3qYmNwZGIe9w0lc')">
                </div>
            </div>
            <!-- Top Layer Subtle Grid lines -->
            <div class="absolute inset-0 bg-gradient-to-t from-primary-container via-primary-container/85 to-primary-container/40 pointer-events-none"></div>
            <!-- Left Header Brand Badge -->
            <div class="relative z-10">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-white shadow-sm mb-space-lg">
                    <span class="w-2 h-2 rounded-full bg-secondary-container animate-pulse"></span>
                    <span class="font-label-sm text-label-sm font-semibold tracking-wide">CANLI OPERASYONEL AĞ PLATFORMU</span>
                </div>
                <h1 class="font-display text-display font-bold text-on-primary max-w-xl leading-tight tracking-tight">
                    Türkiye'nin En Kapsamlı Akıllı Kargo &amp; Lojistik Ağı
                </h1>
                <p class="mt-space-md font-body-lg text-body-lg text-inverse-primary/80 max-w-lg">
                 
                </p>
            </div>
         
          
          
        </div>
        <!-- RIGHT SIDE: Corporate Login Canvas -->
        <div class="w-full lg:w-5/12 flex items-center justify-center p-space-md sm:p-space-lg lg:p-space-xl xl:p-space-2xl bg-surface-container-lowest">
            <div class="w-full max-w-md mx-auto flex flex-col justify-center">
                <!-- Form Header Section -->
                <div class="mb-space-lg">
                    <div class="flex items-center justify-between mb-space-sm">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-label-sm font-label-sm bg-surface-container text-secondary font-semibold">
                            <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                            Güvenli Oturum Portalı
                        </span>
                        <span class="font-body-sm text-body-sm text-on-surface-variant">v4.8.2 Enterprise</span>
                    </div>
                    <h2 class="font-headline-lg text-headline-lg font-bold text-on-surface tracking-tight">
                        Operasyon &amp; Müşteri Paneline Giriş Yap
                    </h2>
                    <p class="mt-1 font-body-md text-body-md text-on-surface-variant">
                        Hesabınız yok mu?
                        <a class="text-secondary font-semibold hover:underline decoration-secondary transition-all" href="#kayit">
                            Hemen Kayıt Ol
                        </a>
                    </p>
                </div>
                <!-- User Role Switcher Tabs (Segmented Control) -->
                <div class="bg-surface-container-low p-1 rounded-xl flex items-center mb-space-lg border border-outline-variant/60" role="tablist">
                    <button class="tab-button flex-1 py-2 px-3 rounded-lg text-label-md font-label-md font-semibold text-on-surface bg-surface-container-lowest shadow-sm transition-all text-center flex items-center justify-center gap-1.5" id="tab-corporate" type="button">
                        <span class="material-symbols-outlined text-[18px] text-secondary" data-icon="business">business</span>
                        Kurumsal
                    </button>
                    <button class="tab-button flex-1 py-2 px-3 rounded-lg text-label-md font-label-md font-medium text-on-surface-variant hover:text-on-surface transition-all text-center flex items-center justify-center gap-1.5" id="tab-branch" type="button">
                        <span class="material-symbols-outlined text-[18px]" data-icon="badge">badge</span>
                        Şube Personeli
                    </button>
                    <button class="tab-button flex-1 py-2 px-3 rounded-lg text-label-md font-label-md font-medium text-on-surface-variant hover:text-on-surface transition-all text-center flex items-center justify-center gap-1.5" id="tab-customer" type="button">
                        <span class="material-symbols-outlined text-[18px]" data-icon="person">person</span>
                        Bireysel
                    </button>
                </div>
                <!-- The Login Form -->
                <form class="space-y-space-md" asp-controller="Auth" asp-action="Login" method="post">
                    <!-- Identity Input (Email or Staff ID) -->
                    <div>
                        <label class="block font-label-md text-label-md font-semibold text-on-surface mb-1.5" for="identifier" id="identifier-label">
                            E-posta Adresi veya Sicil No
                        </label>
                        <div class="relative rounded-lg shadow-sm">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-outline">
                                <span class="material-symbols-outlined text-[20px]" data-icon="alternate_email" id="identifier-icon">alternate_email</span>
                            </div>
                            <input class="block w-full rounded-lg border border-outline-variant bg-surface-container-lowest pl-10 pr-3 py-2.5 text-on-surface font-body-md text-body-md placeholder-outline focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all outline-none" id="identifier" name="Email" value= @Model.Email placeholder="ornek@sirketiniz.com ya da SICIL-8921" required="" type="text" />
                        </div>
                    </div>
                    <!-- Password Input -->
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="block font-label-md text-label-md font-semibold text-on-surface" for="password">
                                Parola
                            </label>
                            <a class="font-label-sm text-label-sm font-semibold text-secondary hover:underline" href="#sifre-sifirla">
                                Şifremi Unuttum?
                            </a>
                        </div>
                        <div class="relative rounded-lg shadow-sm">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-outline">
                                <span class="material-symbols-outlined text-[20px]" data-icon="lock">lock</span>
                            </div>
                            <input class="block w-full rounded-lg border border-outline-variant bg-surface-container-lowest pl-10 pr-10 py-2.5 text-on-surface font-body-md text-body-md placeholder-outline focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all outline-none" value= @Model.Password id="password" name="Password" placeholder="••••••••••••" required="" type="password" />
                            <button aria-label="Şifreyi Göster" class="absolute inset-y-0 right-0 flex items-center pr-3 text-outline hover:text-on-surface transition-colors" id="toggle-password" type="button">
                                <span class="material-symbols-outlined text-[20px]" data-icon="visibility" id="eye-icon">visibility</span>
                            </button>
                        </div>
                    </div>
                    <!-- Remember Me Checkbox & Security Indicator -->
                    <div class="flex items-center justify-between pt-1">
                        <label class="flex items-center gap-2 cursor-pointer select-none">
                            <input checked="" class="h-4 w-4 rounded border-outline-variant text-primary focus:ring-secondary/30 accent-primary cursor-pointer" name="RememberMe" value= @Model.RememberMe type="checkbox" />
                            <span class="font-label-md text-label-md text-on-surface font-medium">Bu cihazda beni hatırla</span>
                        </label>
                       
                    </div>
                    <!-- Primary Submit Action Button -->
                    <button class="w-full mt-2 bg-primary text-on-primary font-label-lg text-label-lg font-semibold py-3 px-space-md rounded-lg shadow-sm hover:bg-inverse-surface active:scale-[0.99] transition-all flex items-center justify-center gap-2 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2" type="submit">
                        <span>Giriş Yap</span>
                        <span class="material-symbols-outlined text-[18px]" data-icon="arrow_forward">arrow_forward</span>
                    </button>
                </form>
                <!-- Divider -->
                <div class="relative my-space-lg">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-outline-variant"></div>
                    </div>
                    <div class="relative flex justify-center text-label-sm font-label-sm">
                        <span class="bg-surface-container-lowest px-3 text-on-surface-variant font-medium">veya kurumsal doğrulama</span>
                    </div>
                </div>
                <!-- Corporate SSO Options -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm mb-space-lg">
                    <!-- Enterprise SSO -->
                    <button class="w-full flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest hover:bg-surface-container-low text-on-surface font-label-md text-label-md font-semibold transition-all active:scale-[0.98]" type="button">
                        <span class="material-symbols-outlined text-[18px] text-secondary" data-icon="domain_verification">domain_verification</span>
                      
                    </button>
                    <!-- Google Workspace -->
                    <button class="w-full flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest hover:bg-surface-container-low text-on-surface font-label-md text-label-md font-semibold transition-all active:scale-[0.98]" type="button">
                        <svg class="w-4 h-4" viewbox="0 0 24 24">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"></path>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"></path>
                        </svg>
                        <span>Google Workspace</span>
                    </button>
                </div>
                <!-- Security Badge & Support Link Footnote -->
               
            </div>
        </div>
    </main>
  
    <script>
        // Tab Segment Logic
        const tabs = [
          { id: 'tab-corporate', label: 'Kurumsal', placeholder: 'ornek@sirketiniz.com', icon: 'alternate_email', fieldLabel: 'Kurumsal E-posta veya Şirket Kodu' },
          { id: 'tab-branch', label: 'Şube Personeli', placeholder: 'SICIL-48192 veya Personel E-posta', icon: 'badge', fieldLabel: 'Personel Sicil No veya Dahili Posta' },
          { id: 'tab-customer', label: 'Bireysel', placeholder: 'ad.soyad@eposta.com veya GSM No', icon: 'phone_iphone', fieldLabel: 'Kullanıcı E-posta veya Telefon Numarası' }
        ];

        const inputField = document.getElementById('identifier');
        const inputLabel = document.getElementById('identifier-label');
        const inputIcon = document.getElementById('identifier-icon');

        tabs.forEach(tab => {
          const btn = document.getElementById(tab.id);
          btn.addEventListener('click', () => {
            // Reset all buttons styling
            document.querySelectorAll('.tab-button').forEach(b => {
              b.className = 'tab-button flex-1 py-2 px-3 rounded-lg text-label-md font-label-md font-medium text-on-surface-variant hover:text-on-surface transition-all text-center flex items-center justify-center gap-1.5';
              const iconSpan = b.querySelector('.material-symbols-outlined');
              if (iconSpan) iconSpan.classList.remove('text-secondary');
            });

            // Active button styling
            btn.className = 'tab-button flex-1 py-2 px-3 rounded-lg text-label-md font-label-md font-semibold text-on-surface bg-surface-container-lowest shadow-sm transition-all text-center flex items-center justify-center gap-1.5';
            const activeIcon = btn.querySelector('.material-symbols-outlined');
            if (activeIcon) activeIcon.classList.add('text-secondary');

            // Update form hints
            inputField.placeholder = tab.placeholder;
            inputLabel.innerText = tab.fieldLabel;
            inputIcon.innerText = tab.icon;
          });
        });

        // Toggle Password Visibility
        const toggleBtn = document.getElementById('toggle-password');
        const pwdInput = document.getElementById('password');
        const eyeIcon = document.getElementById('eye-icon');

        toggleBtn.addEventListener('click', () => {
          const isPassword = pwdInput.getAttribute('type') === 'password';
          pwdInput.setAttribute('type', isPassword ? 'text' : 'password');
          eyeIcon.innerText = isPassword ? 'visibility_off' : 'visibility';
        });
    </script>
</body>
</html>