
<!DOCTYPE html>

<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CargoTrack</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
          rel="stylesheet" />

    <!-- Material Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
          rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700&display=swap"
          rel="stylesheet" />
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Tailwind Configuration -->
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "error-container": "#ffdad6",
                        "surface-dim": "#cbdbf5",
                        "tertiary-fixed-dim": "#4edea3",
                        "secondary-container": "#fd651e",
                        "secondary-fixed-dim": "#ffb599",
                        "on-tertiary": "#ffffff",
                        "surface-bright": "#f8f9ff",
                        "tertiary-container": "#002113",
                        "on-surface-variant": "#45464d",
                        "outline": "#76777d",
                        "on-primary-fixed-variant": "#3f465c",
                        "tertiary-fixed": "#6ffbbe",
                        "on-tertiary-fixed": "#002113",
                        "on-secondary": "#ffffff",
                        "surface": "#f8f9ff",
                        "secondary": "#a73a00",
                        "primary-fixed-dim": "#bec6e0",
                        "outline-variant": "#c6c6cd",
                        "background": "#f8f9ff",
                        "on-background": "#0b1c30",
                        "error": "#ba1a1a",
                        "primary": "#000000",
                        "surface-tint": "#565e74",
                        "inverse-on-surface": "#eaf1ff",
                        "inverse-primary": "#bec6e0",
                        "on-secondary-container": "#571a00",
                        "secondary-fixed": "#ffdbce",
                        "on-primary-fixed": "#131b2e",
                        "on-primary-container": "#7c839b",
                        "surface-container-high": "#dce9ff",
                        "on-tertiary-fixed-variant": "#005236",
                        "on-surface": "#0b1c30",
                        "surface-container-low": "#eff4ff",
                        "primary-fixed": "#dae2fd",
                        "primary-container": "#131b2e",
                        "surface-variant": "#d3e4fe",
                        "on-error-container": "#93000a",
                        "inverse-surface": "#213145",
                        "surface-container-highest": "#d3e4fe",
                        "on-error": "#ffffff",
                        "surface-container": "#e5eeff",
                        "on-primary": "#ffffff",
                        "surface-container-lowest": "#ffffff",
                        "tertiary": "#000000",
                        "on-tertiary-container": "#009668",
                        "on-secondary-fixed": "#370e00",
                        "on-secondary-fixed-variant": "#7f2b00"
                    },

                    borderRadius: {
                        DEFAULT: "0.25rem",
                        lg: "0.5rem",
                        xl: "0.75rem",
                        full: "9999px"
                    },

                           spacing: {
            "space-lg": "1.5rem",
            "space-2xl": "3rem",
            "margin-mobile": "1rem",
            "gutter-sm": "1rem",
            "gutter": "1.5rem",
            "space-xs": "0.25rem",
            "space-xl": "2rem",
            "space-sm": "0.5rem",
            "space-md": "1rem",
            "margin": "2rem",

            // Tracking Index için
            "section-padding": "4rem",
            "container-max-width": "1200px",
            "stack-sm": "0.5rem",
            "stack-md": "1rem",
            "stack-lg": "2rem"
        },

                    fontFamily: {
                        "label-lg": ["Inter"],
                        "label-sm": ["Inter"],
                        "code-tracking": ["Inter"],
                        "body-lg": ["Inter"],
                        "body-sm": ["Inter"],
                        "metric-number": ["Plus Jakarta Sans"],
                        "headline-sm": ["Plus Jakarta Sans"],
                        "headline-lg-mobile": ["Plus Jakarta Sans"],
                        "display-mobile": ["Plus Jakarta Sans"],
                        display: ["Plus Jakarta Sans"],
                        "headline-lg": ["Plus Jakarta Sans"],
                        "label-md": ["Inter"],
                        "headline-md": ["Plus Jakarta Sans"],
                        "body-md": ["Inter"],
                                "headline-xl": ["Hanken Grotesk"],
        "status-label": ["Hanken Grotesk"]
                    },

                    fontSize: {
                        "label-lg": ["14px", {
                            lineHeight: "20px",
                            fontWeight: "500"
                        }],
                        "label-sm": ["11px", {
                            lineHeight: "14px",
                            letterSpacing: "0.02em",
                            fontWeight: "600"
                        }],
                        "code-tracking": ["13px", {
                            lineHeight: "18px",
                            letterSpacing: "0.04em",
                            fontWeight: "600"
                        }],
                        "body-lg": ["16px", {
                            lineHeight: "24px",
                            fontWeight: "400"
                        }],
                        "body-sm": ["12px", {
                            lineHeight: "16px",
                            fontWeight: "400"
                        }],
                        "metric-number": ["24px", {
                            lineHeight: "32px",
                            letterSpacing: "-0.02em",
                            fontWeight: "700"
                        }],
                        "headline-sm": ["16px", {
                            lineHeight: "24px",
                            fontWeight: "600"
                        }],
                        "headline-lg-mobile": ["22px", {
                            lineHeight: "30px",
                            letterSpacing: "-0.01em",
                            fontWeight: "600"
                        }],
                        "display-mobile": ["28px", {
                            lineHeight: "36px",
                            letterSpacing: "-0.01em",
                            fontWeight: "700"
                        }],
                        display: ["36px", {
                            lineHeight: "44px",
                            letterSpacing: "-0.02em",
                            fontWeight: "700"
                        }],
                        "headline-lg": ["28px", {
                            lineHeight: "36px",
                            letterSpacing: "-0.015em",
                            fontWeight: "600"
                        }],
                        "label-md": ["12px", {
                            lineHeight: "16px",
                            letterSpacing: "0.01em",
                            fontWeight: "600"
                        }],
                        "headline-md": ["20px", {
                            lineHeight: "28px",
                            letterSpacing: "-0.01em",
                            fontWeight: "600"
                        }],
                        "body-md": ["14px", {
                            lineHeight: "20px",
                            fontWeight: "400"
                        }],
                                "headline-xl": ["40px", {
            lineHeight: "48px",
            letterSpacing: "-0.02em",
            fontWeight: "700"
        }],

        "status-label": ["13px", {
            lineHeight: "18px",
            fontWeight: "600"
        }]
                    }
                }
            }
        };
    </script>

    <!-- Global CSS -->
    <style>
        /* Genel sıfırlama */
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
        }

        /* Genel sayfa ayarları */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9ff;
            color: #0b1c30;
            overscroll-behavior: none;
        }

        /* Ana içerik boşlukları */
        main > :first-child {
            margin-top: 0;
        }

        main > :last-child {
            margin-bottom: 0;
        }

        /* Scrollbar gizleme */
        ::-webkit-scrollbar {
            display: none;
        }

        /* Material Symbols */
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        /* Dolu ikon */
        .filled-icon {
            font-variation-settings: 'FILL' 1;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="min-h-screen flex flex-col bg-surface text-on-surface antialiased font-body-md">
    <!-- TopNavBar -->
    <nav class="bg-surface dark:bg-primary-container font-body-md text-body-md docked full-width top-0 border-b border-outline-variant dark:border-on-primary-container shadow-sm">
        <div class="flex justify-between items-center px-gutter py-4 max-w-container-max-width mx-auto">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary dark:text-primary-fixed">package_2</span>
                <span class="font-headline-md text-headline-md font-bold text-on-background dark:text-surface-bright">CargoTrack</span>
            </div>
            <div class="hidden md:flex gap-6 items-center">
                <a class="text-on-surface-variant dark:text-on-primary-container hover:text-primary dark:hover:text-primary-fixed hover:bg-surface-container-low dark:hover:bg-tertiary-container transition-colors px-2 py-1 rounded" href="/Home/Index">Ana Sayfa</a>
                <a class="text-secondary dark:text-secondary-fixed-dim font-bold border-b-2 border-secondary pb-1" href="/Tracking/Index">Kargo Takip</a>
                <a class="text-on-surface-variant dark:text-on-primary-container hover:text-primary dark:hover:text-primary-fixed hover:bg-surface-container-low dark:hover:bg-tertiary-container transition-colors px-2 py-1 rounded" href="#">Şubelerimiz</a>
                <a class="text-on-surface-variant dark:text-on-primary-container hover:text-primary dark:hover:text-primary-fixed hover:bg-surface-container-low dark:hover:bg-tertiary-container transition-colors px-2 py-1 rounded" href="#">Hizmetlerimiz</a>
                <a class="text-on-surface-variant dark:text-on-primary-container hover:text-primary dark:hover:text-primary-fixed hover:bg-surface-container-low dark:hover:bg-tertiary-container transition-colors px-2 py-1 rounded" href="#">Hakkımızda</a>
                <a class="text-on-surface-variant dark:text-on-primary-container hover:text-primary dark:hover:text-primary-fixed hover:bg-surface-container-low dark:hover:bg-tertiary-container transition-colors px-2 py-1 rounded" href="#">İletişim</a>
            </div>
            <button class="bg-primary-container text-on-primary px-6 py-2.5 rounded-DEFAULT font-semibold flex items-center gap-2 scale-95 active:opacity-80 transition-transform hover:bg-primary">
                <span class="material-symbols-outlined text-sm">send</span>
                Kargo Gönder
            </button>
        </div>
    </nav>
    <!-- Main Content -->
    @RenderBody()
   
    <!-- Footer -->
    <footer class="bg-primary-container dark:bg-primary font-body-md text-body-md full-width bottom flex flex-col md:flex-row justify-between items-center px-gutter py-8 w-full mt-auto">
        <div class="text-surface-bright font-body-md text-body-md mb-4 md:mb-0 opacity-90">
            © 2024 CargoTrack Lojistik A.Ş. Tüm hakları saklıdır.
        </div>
        <div class="flex flex-wrap gap-4 md:gap-6 justify-center">
            <a class="text-on-primary-container dark:text-primary-fixed-dim opacity-80 hover:opacity-100 hover:text-secondary-container dark:hover:text-secondary-fixed transition-colors" href="#">Gizlilik Politikası</a>
            <a class="text-on-primary-container dark:text-primary-fixed-dim opacity-80 hover:opacity-100 hover:text-secondary-container dark:hover:text-secondary-fixed transition-colors" href="#">Kullanım Şartları</a>
            <a class="text-on-primary-container dark:text-primary-fixed-dim opacity-80 hover:opacity-100 hover:text-secondary-container dark:hover:text-secondary-fixed transition-colors" href="#">KVKK Aydınlatma Metni</a>
            <a class="text-on-primary-container dark:text-primary-fixed-dim opacity-80 hover:opacity-100 hover:text-secondary-container dark:hover:text-secondary-fixed transition-colors" href="#">Sıkça Sorulan Sorular</a>
        </div>
    </footer>
</body>
</html>