@using DtoLayer.DTOs.AboutDtos
@model ResultAboutDto

<section class="relative w-full -mt-20 overflow-hidden bg-gradient-to-b from-surface-container-high/40 via-surface to-surface">
    <div class="relative w-full px-margin pt-32 pb-16 max-w-7xl mx-auto flex flex-col gap-space-xl">
        <!-- Top Pill & Visual Headline Group -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">
            <div class="lg:col-span-7 flex flex-col gap-space-md">
                <div class="inline-flex items-center gap-space-xs px-space-sm py-1 rounded-full bg-surface-container-lowest shadow-sm w-fit">
                    <span class="flex h-2 w-2 rounded-full bg-secondary-container animate-pulse"></span>
                    <span class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-semibold">@Model.Title</span>
                </div>
                <h1 class="font-display text-display text-on-surface font-extrabold tracking-tight leading-tight">
                    Hızlı, Güvenilir ve <br class="hidden sm:inline" />
                    <span class="text-secondary-container">Akıllı Kargo</span> Taşımacılığı
                </h1>
                <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl">
					@Model.Description
                </p>
                <!-- Rapid Micro Metrics -->
                <div class="grid grid-cols-3 gap-space-md pt-space-xs max-w-lg">
                    <div class="flex flex-col">
                        <span class="font-metric-number text-metric-number text-on-surface font-bold tracking-tight">81 İl</span>
                        <span class="font-body-sm text-body-sm text-on-surface-variant">Kesintisiz Rota</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-metric-number text-metric-number text-secondary font-bold tracking-tight">%99.4</span>
                        <span class="font-body-sm text-body-sm text-on-surface-variant">Zamanında Teslim</span>
                    </div>
                   
                </div>
            </div>
            <!-- Hero Graphic Frame -->
            <div class="lg:col-span-5 relative">
                <div class="relative w-full rounded-2xl overflow-hidden shadow-xl bg-surface-container-lowest">
                    <img alt="KargoHQ Ekspres Kargo Aracı Yolda" class="w-full h-80 lg:h-96 object-cover transform hover:scale-105 transition-transform duration-700" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAE7YoB8QM9O0QGe3qbiJ0FPHhSk0Mh4p7PCeen3Oh-pbcJeT-nmIJaCWXCraIENTIVZUVDtr3D-g3Jy1Zr5R3NPcCrwed57Ssqq3ghI2ORhuTXlHMcI-ZWMVtL0uAmh4qFde4U_gA5PDrfBbGwQKjMoLtnJUgTJ2Dv68feoav5eaRMYhsehIOGP1iPfgtJ0T87963qLLTVcaUistk8cUJONwayoCnX9VMbFhbqE1I" />
                    <!-- Live Vehicle Telemetry Badge Overlay -->
                    <div class="absolute bottom-4 left-4 right-4 bg-surface-container-lowest/95 backdrop-blur-md p-space-md rounded-xl shadow-md flex items-center justify-between">
                        <div class="flex items-center gap-space-sm">
                            <div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-secondary-container">
                                <span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1;">near_me</span>
                            </div>
                            <div>
                                <div class="font-label-md text-label-md text-on-surface font-semibold">İstanbul - Ankara Ekspres Hat</div>
                                <div class="font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-tertiary-fixed-dim"></span> Aktif Seyir • Tahmini Varış: 22:45
                                </div>
                            </div>
                        </div>
                        <span class="font-label-sm text-label-sm bg-surface-container-low text-on-surface px-space-sm py-1 rounded-md">34 KHQ 82</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>
