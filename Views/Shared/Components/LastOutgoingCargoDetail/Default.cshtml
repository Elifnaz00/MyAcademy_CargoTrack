@using DtoLayer.DTOs.CargoDtos
@model UserActiveCargoDto
@using EntityLayer.Entities.Enums

@{
    Layout = null;
    var steps = new[]
    {
        new { Status = CargoStatus.Created, Title = "Kargo Oluşturuldu", Icon = "inventory_2" },
        new { Status = CargoStatus.AtOriginBranch, Title = "Çıkış Şubesinde", Icon = "store" },
        new { Status = CargoStatus.InTransferCenter, Title = "Transfer Merkezinde", Icon = "warehouse" },
        new { Status = CargoStatus.AtDestinationBranch, Title = "Varış Şubesinde", Icon = "location_on" },
        new { Status = CargoStatus.OutForDelivery, Title = "Dağıtıma Çıktı", Icon = "local_shipping" },
        new { Status = CargoStatus.Delivered, Title = "Teslim Edildi", Icon = "home" }
    };

    var currentStatus = (int)Model.CargoStatus;
}

<section class="grid grid-cols-1 gap-6">

    <div class="lg:col-span-8 bg-surface-container-lowest rounded-2xl border border-surface-container elevation-1 overflow-hidden flex flex-col h-fit">
        <!-- Kart Üst Barı -->
        <div class="p-space-lg border-b border-surface-container flex flex-wrap items-center justify-between gap-3 bg-surface-container-low/40">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-secondary-fixed flex items-center justify-center text-secondary">
                    <span class="material-symbols-outlined text-[22px]" data-icon="electric_moped">electric_moped</span>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="text-headline-sm font-headline-sm text-on-surface">@Model.TrackCode</span>
                        <span class="px-2.5 py-0.5 rounded-full text-label-sm font-label-sm bg-secondary-fixed text-on-secondary-fixed font-semibold">@Model.DeliveryType</span>
                    </div>

                </div>
            </div>
            <!-- Durum ve Tahmin Rozeti -->
            <div class="text-right">
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-label-sm font-label-sm bg-secondary-container text-on-secondary font-bold">
                    <span class="w-2 h-2 rounded-full bg-white pulse-glow"></span>
                    <span>@Model.CargoStatus🚚</span>
                </div>
                <p class="text-label-sm font-label-sm text-on-surface-variant mt-1">
                    Tahmini Teslim: <strong class="text-on-surface font-semibold">@Model.EstimatedArrivalDate</strong>
                </p>
            </div>
        </div>
        <!-- Aşama Takip Göstergesi (Shipment Stepper) -->
        <div class="px-space-lg py-3 border-b border-surface-container">

            <div class="grid grid-cols-6 relative">

                <!-- Bağlantı çizgisi -->
                <div class="absolute top-4 left-6 right-6 h-0.5 bg-surface-container">
                    @{
                        var progress = currentStatus switch
                        {
                            1 => 0,
                            2 => 20,
                            3 => 40,
                            4 => 60,
                            5 => 80,
                            6 => 100,
                            _ => 0
                        };
                    }

                    <div class="h-full bg-secondary-container transition-all"
                         style="width: @(progress)%">
                    </div>
                </div>

                @foreach (var step in steps)
                {
                    var stepStatus = (int)step.Status;

                    var isCompleted = currentStatus > stepStatus;
                    var isActive = currentStatus == stepStatus;

                    <div class="flex flex-col items-center text-center relative z-10">

                        <div class="w-8 h-8 rounded-full flex items-center justify-center ring-4 ring-white mb-2 shadow-sm
                        @(isCompleted ? "bg-tertiary-fixed text-on-tertiary-fixed-variant" :
                                                   isActive ? "bg-secondary-container text-on-secondary pulse-glow" :
                                                   "bg-surface-container text-on-surface-variant opacity-50")">

                            <span class="material-symbols-outlined text-[16px]">
                                @(isCompleted ? "check" : step.Icon)
                            </span>

                        </div>

                        <span class="text-label-md font-label-md
                        @(isActive ? "text-secondary font-bold" :
                                                    isCompleted ? "text-on-surface" :
                                                    "text-on-surface-variant opacity-50")">

                        @step.Title

                        </span>

                    @{
                            var movement = Model.CargoMovements?
                            .FirstOrDefault(x => x.NewStatus == step.Status);
                        }

                        <span class="text-body-sm font-body-sm text-on-surface-variant">

                            @if (movement != null)
                            {
                                @movement.MovementDate.ToString("dd MMM, HH:mm", new System.Globalization.CultureInfo("tr-TR"))
                            }
                            else if (isActive)
                            {
                                @Model.ShipmentDate.ToString("dd MMM, HH:mm", new System.Globalization.CultureInfo("tr-TR"))
                            }
                            else
                            {
                                <text>Bekleniyor</text>
                            }

                        </span>

                    </div>
                }

            </div>
        </div>


    </div>
    <!--  Kargo Detay  Paneli / İnceleme Alanı (4 Sütun) -->
    <div class="lg:col-span-4 space-y-6">
        <div class="bg-surface-container-lowest rounded-2xl border border-surface-container elevation-1 p-space-lg flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between border-b border-surface-container pb-3">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary-container" data-icon="receipt_long">receipt_long</span>
                        <h3 class="text-headline-sm font-headline-sm text-on-surface">Kargo Tipi</h3>
                    </div>
                    <span class="text-label-sm font-label-sm text-on-tertiary-container font-semibold bg-tertiary-fixed px-2 py-0.5 rounded">@Model.CargoType</span>
                </div>
                <!-- Barkod & Desi Verisi -->
                <div class="mt-4 p-3 rounded-xl bg-surface border border-surface-container flex flex-col items-center">
                    <!-- Barkod Görsel Çizgileri Mockup -->
                    <div class="flex items-center justify-center gap-1 h-12 w-full px-4 py-1 bg-white rounded border border-surface-container">
                        <div class="w-1 h-9 bg-black"></div>
                        <div class="w-2 h-9 bg-black"></div>
                        <div class="w-0.5 h-9 bg-black"></div>
                        <div class="w-1.5 h-9 bg-black"></div>
                        <div class="w-3 h-9 bg-black"></div>
                        <div class="w-1 h-9 bg-black"></div>
                        <div class="w-0.5 h-9 bg-black"></div>
                        <div class="w-2 h-9 bg-black"></div>
                        <div class="w-1.5 h-9 bg-black"></div>
                        <div class="w-0.5 h-9 bg-black"></div>
                        <div class="w-2.5 h-9 bg-black"></div>
                        <div class="w-1 h-9 bg-black"></div>
                        <div class="w-3 h-9 bg-black"></div>
                        <div class="w-1 h-9 bg-black"></div>
                    </div>
                    <span class="font-code-tracking text-code-tracking text-on-surface mt-1.5 tracking-widest font-mono">@Model.TrackCode</span>
                </div>
                <!-- Özellik Matrisi -->
                <div class="mt-4 grid grid-cols-2 gap-3 text-body-sm">
                    <div class="p-2.5 rounded-lg bg-surface-container-low">
                        <span class="text-label-sm font-label-sm text-on-surface-variant block">Ağırlık &amp; Hacim</span>
                        <span class="font-bold text-on-surface">@Model.Desi • @Model.Weight kg</span>
                    </div>
                    <div class="p-2.5 rounded-lg bg-surface-container-low">
                        <span class="text-label-sm font-label-sm text-on-surface-variant block">Hizmet Türü</span>
                        <span class="font-bold text-on-surface">VIP Randevulu</span>
                    </div>
                    <div class="p-2.5 rounded-lg bg-surface-container-low">
                        <span class="text-label-sm font-label-sm text-on-surface-variant block">Ödeme Tipi</span>
                        <span class="font-bold text-on-surface">Gönderici Ödemeli</span>
                    </div>
                    <div class="p-2.5 rounded-lg bg-surface-container-low">
                        <span class="text-label-sm font-label-sm text-on-surface-variant block">Güvenlik</span>
                        <span class="font-bold text-on-surface">SMS Kodlu Teslimat</span>
                    </div>
                </div>
                <!-- Adres Bilgisi Özeti -->
                <div class="mt-4 pt-3 border-t border-surface-container space-y-3">
                    <div class="flex items-start gap-2.5">
                        <span class="material-symbols-outlined text-[18px] text-on-surface-variant mt-0.5" data-icon="storefront">storefront</span>
                        <div>
                            <span class="text-label-sm font-label-sm text-on-surface-variant block">Gönderen</span>
                            <p class="text-body-sm font-body-sm text-on-surface font-semibold">@Model.SenderAddressTitle</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-2.5">
                        <span class="material-symbols-outlined text-[18px] text-secondary mt-0.5" data-icon="location_on">location_on</span>
                        <div>
                            <span class="text-label-sm font-label-sm text-on-surface-variant block">Teslimat Adresi</span>
                            <p class="text-body-sm font-body-sm text-on-surface font-semibold">@Model.ReceiverAddress</p>
                        </div>
                    </div>
                </div>
                <!-- Son Hareket Geçmişi Zaman Çizelgesi -->
                <!-- Son Hareket Geçmişi Zaman Çizelgesi -->
                <div class="mt-5 pt-3 border-t border-surface-container">

                    <h4 class="text-label-md font-label-md text-on-surface-variant uppercase tracking-wider mb-3">
                        Son Hareket Geçmişi (Log)
                    </h4>

                    <div class="space-y-3 relative pl-4 border-l-2 border-surface-container text-body-sm font-body-sm">

                        @if (Model.CargoMovements != null && Model.CargoMovements.Any())
                        {
                            @foreach (var movement in Model.CargoMovements.OrderByDescending(x => x.MovementDate))
                            {
                                <div class="relative">

                                    <div class="absolute -left-[21px] top-1 w-2.5 h-2.5 rounded-full bg-secondary-container"></div>

                                    <span class="text-label-sm font-label-sm font-bold text-secondary">
                                        @movement.MovementDate.ToString("dd MMM, HH:mm", new System.Globalization.CultureInfo("tr-TR"))
                                    </span>

                                    <p class="text-on-surface font-medium">
                                        @movement.Description
                                    </p>

                                    <p class="text-body-sm text-on-surface-variant">
                                        @if (!string.IsNullOrEmpty(movement.TransferCenterName))
                                        {
                                            @movement.TransferCenterName
                                        }
                                        else if (!string.IsNullOrEmpty(movement.BranchName))
                                        {
                                            @movement.BranchName
                                        }

                                        @if (!string.IsNullOrEmpty(movement.CityName))
                                        {
                                            <span> - @movement.CityName</span>
                                        }
                                    </p>

                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-on-surface-variant">
                                Henüz hareket kaydı bulunmuyor.
                            </p>
                        }

                    </div>
                </div>
            </div>
            <!-- Canlı İletişim / Güvenlik Kodu Butonu -->
            <div class="mt-6 pt-3 border-t border-surface-container">
                <div class="p-3 bg-secondary-fixed/50 rounded-xl flex items-center justify-between">
                    <div>
                        <span class="text-label-sm font-label-sm text-secondary font-bold block">Teslimat Doğrulama Kodu</span>
                        <span class="text-metric-number font-metric-number text-on-secondary-fixed">842-190</span>
                    </div>
                    <button class="px-3 py-1.5 bg-surface-container-lowest text-on-surface text-label-sm font-label-sm rounded-lg border border-surface-container hover:bg-surface transition">
                        Kodu Paylaş
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>
